{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadet-agent.dev/harness-v2.json",
  "title": "Cadet-Agent Harness Records",
  "description": "Schemas for harness policy, run ledgers, spans, evidence, decisions, and state v2. Contract: docs/core/HarnessContract.md.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "context-resolution",
        "requirements",
        "requirementsComplete",
        "architecture",
        "architectureComplete",
        "spikes",
        "story-breakdown",
        "implementation",
        "review",
        "validation",
        "closed"
      ]
    },
    "gate": {
      "type": "string",
      "enum": [
        "codeReviewCompleted",
        "testsPassed",
        "storyTrackingUpdated",
        "compileCheckConfirmed",
        "unityAnalyzerClean",
        "acceptanceCriteriaValidated",
        "securityReviewPassed",
        "designArtifactSyncConfirmed",
        "reachabilityAddressed",
        "designReviewCompleted",
        "humanAcceptanceConfirmed",
        "architectureFitnessPassed",
        "userPlaythroughConfirmed"
      ]
    },
    "evidenceStatus": {
      "type": "string",
      "enum": ["passed", "failed", "blocked", "manual-confirmation", "superseded"]
    },
    "retryClass": {
      "type": "string",
      "enum": ["deterministic", "transient", "repair", "unknown"]
    },
    "contextTier": {
      "type": "string",
      "enum": ["tier0", "tier1", "tier2", "tier3"]
    },
    "budget": {
      "type": "object",
      "required": ["hard"],
      "properties": {
        "hard": { "type": "number", "minimum": 0 },
        "warn": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "unit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "$schema": { "type": "string" },
        "budgets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/budget" }
        },
        "archive": {
          "type": "object",
          "properties": {
            "maxCompressedBytes": { "type": "integer", "minimum": 0 },
            "maxDecompressedBytes": { "type": "integer", "minimum": 0 },
            "maxFiles": { "type": "integer", "minimum": 0 },
            "maxFilenameBytes": { "type": "integer", "minimum": 0 },
            "maxCompressionRatio": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "maxInlineBytes": { "type": "integer", "minimum": 0 },
            "previewBytes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "retention": {
          "type": "object",
          "properties": {
            "keepOnFailure": { "type": "boolean" },
            "retainRunRecords": { "type": "boolean" },
            "retainRawPrompt": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "estimation": {
          "type": "object",
          "properties": {
            "bytesPerToken": { "type": "integer", "minimum": 1 },
            "rateCards": { "type": "object" }
          },
          "additionalProperties": false
        },
        "hook": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["ask-on-recognized-write", "fail-open"] }
          },
          "additionalProperties": false
        },
        "allowBudgetCeilingOverride": { "type": "boolean" },
        "allowEmptyFreshness": { "type": "boolean" },
        "scopes": {
          "type": "object",
          "properties": {
            "perRun": { "type": "object" },
            "perStory": { "type": "object" }
          },
          "additionalProperties": false
        },
        "model": { "type": ["string", "null"] },
        "analyzerCommand": { "type": ["string", "null"] },
        "compileCommand": { "type": ["string", "null"] },
        "testCommand": { "type": ["string", "null"] },
        "reachability": {
          "type": "object",
          "description": "Contract v6 §2. Reachability enforcement. Absent or enabled:false is byte-identical pre-v6 behaviour — the reachability gate is not required and `verify-reachability` reports without writing. `command` is the repository's own reachability probe; when configured it runs as part of `harness verify-reachability` and its exit code is the verdict, because Cadet cannot know how a given repository wires its pieces together. Setting `command` while `enabled` is false is rejected as inert, and a blank or whitespace-only `command` is rejected outright (contract v6 §3).",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "command": {
              "type": ["string", "null"],
              "default": null,
              "minLength": 1,
              "pattern": "\\S",
              "description": "Requires enabled:true — the resolver rejects a command while the policy is disabled, and rejects a blank or whitespace-only value."
            }
          },
          "allOf": [
            {
              "if": { "properties": { "command": { "type": "string", "minLength": 1 } }, "required": ["command"] },
              "then": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }
            }
          ],
          "additionalProperties": false
        },
        "strictClosure": {
          "type": "object",
          "description": "Contract v3 strict closure. Absent or enabled:false is byte-identical v2 behaviour. Setting any other field while enabled is false is rejected as inert (contract v3 §2).",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "revalidateOnClosure": { "type": "boolean", "default": true },
            "requireFreshRevalidation": { "type": "boolean", "default": true },
            "manualConfirmation": {
              "type": "object",
              "properties": {
                "requireReason": { "type": "boolean", "default": true },
                "requireExpiresAt": { "type": "boolean", "default": true },
                "requireEnvironment": { "type": "boolean", "default": true },
                "requireScope": { "type": "boolean", "default": true },
                "maxValidityMs": { "type": ["integer", "null"], "minimum": 1, "default": 86400000 },
                "clockSkewToleranceMs": { "type": "integer", "minimum": 0, "default": 60000 }
              },
              "additionalProperties": false
            },
            "disallowManualFor": {
              "type": "array",
              "items": { "$ref": "#/$defs/gate" },
              "default": ["testsPassed", "acceptanceCriteriaValidated", "reachabilityAddressed", "architectureFitnessPassed"],
              "description": "Gates that may never be satisfied by a manual confirmation: every one of them has an automated path in every environment Cadet supports. `testsPassed` because the suite always runs somewhere; `acceptanceCriteriaValidated` because `harness verify-acs` derives the test inventory from the run report; `reachabilityAddressed` because the declaration check runs even with no probe configured (contract v6 §2). `compileCheckConfirmed`, `unityAnalyzerClean` and `storyTrackingUpdated` are absent on purpose — their automated path can be missing, so forbidding manual confirmation would leave the gate unsatisfiable."
            }
          },
          "additionalProperties": false
        },
        "architectureFitness": {
          "type": "object",
          "description": "The project's declared executable constraints. Each check has a stable id, a command, the files it governs, a severity, and optionally an artifact it must write. The gate `architectureFitnessPassed` is required on implementation -> review only when `enabled` is true AND at least one check is declared — declared but off, or enabled with no checks, is inert, which is what keeps the frozen transition lists unchanged for a project that declares nothing. There is no command-line override: the checks are the repository's own declaration. A check with severity `advisory` never blocks; its failure is reported and recorded. Samples for C# dependency direction and forbidden Unity references: docs/core/ArchitectureFitness.md.",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "checks": {
              "type": "array",
              "default": [],
              "items": {
                "type": "object",
                "required": ["id", "command"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "Stable slug, unique in the file: a report has to name the same check across runs." },
                  "command": { "type": "string", "description": "Run through the shell, in `cwd`. A non-zero exit is a violation." },
                  "cwd": { "type": "string", "default": ".", "description": "Repository-relative working directory." },
                  "files": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Repository-relative paths the check governs. Empty means it always applies. Matching is at a directory boundary, so `src/Core` does not govern `src/CoreX`." },
                  "timeoutMs": { "type": ["integer", "null"], "default": null, "description": "Positive integer. A check that times out is `blocked`, not failed: nothing was disproved." },
                  "severity": { "type": "string", "enum": ["required", "advisory"], "default": "required" },
                  "refs": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Design sections or ADR identifiers this check enforces, carried into the record so a reader can ask why the constraint exists." },
                  "artifact": { "type": ["string", "null"], "default": null, "description": "Repository-relative file the check must write. A declared artifact that is missing, or unparseable as JSON when artifactFormat is json, leaves the check blocked rather than passed — an exit-zero command that wrote nothing proved nothing." },
                  "artifactFormat": { "type": "string", "enum": ["json", "text"], "default": "text" }
                }
              }
            }
          },
          "additionalProperties": false
        },
        "humanAcceptance": {
          "type": "object",
          "description": "The human-acceptance gate. Absent or enabled:false is byte-identical pre-change behaviour — the gate is not required. When true, `humanAcceptanceConfirmed` is required on `validation -> closed` at evaluation time, not in the transitions table, so the next-story loop (`validation -> implementation`) stays unblocked. The shipped policy file for a new consumer sets it true.",
          "properties": {
            "enabled": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "userPlay": {
          "type": "object",
          "description": "The user-playthrough gate. Absent or enabled:false is byte-identical pre-change behaviour — the gate is not required. When true, `userPlaythroughConfirmed` is required on `review -> validation` — the story boundary — at evaluation time, not in the transitions table, so the next-story loop (`validation -> implementation`) stays unblocked and an epic's closure is covered by `humanAcceptanceConfirmed` alone. The gate is human-owned: `harness verify-play` records it for a story whose `Play:` declaration is `deferred`, and refuses a `required` one. A `required` story is satisfied by asking the person — whether they played it, and what was unexpected — and recording their own answer with `harness confirm --gate userPlaythroughConfirmed --reason \"<what they said>\"`. There is no form to fill in. The shipped policy file for a new consumer sets it true, so a new project hands its game to a person before a story can pass.",
          "properties": {
            "enabled": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "designReview": {
          "type": "object",
          "description": "The formal design-review gate. Absent or enabled:false is byte-identical pre-change behaviour — the gate is not required. When true, `designReviewCompleted` is required on ONE edge, architectureComplete -> story-breakdown, appended at evaluation time rather than declared in the transitions table, so the spikes route into story breakdown is unaffected. The shipped policy file for a new consumer sets it true.",
          "properties": {
            "enabled": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "freshnessPolicy": {
      "type": "object",
      "properties": {
        "scope": { "type": "string", "enum": ["story", "phase", "run", "manual"] },
        "allowPhases": { "type": "array", "items": { "$ref": "#/$defs/phase" } },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" }
      },
      "required": ["scope"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidenceId", "workItemId", "phase", "gate", "status",
        "command", "result", "inputTreeHash", "criteriaHash", "relevantFiles", "createdAt"
      ],
      "anyOf": [
        { "required": ["expiresAt"] },
        { "required": ["freshnessPolicy"] }
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/uuid" },
        "workItemId": { "type": "string" },
        "acceptanceCriterionId": { "type": ["string", "null"] },
        "phase": { "$ref": "#/$defs/phase" },
        "gate": { "$ref": "#/$defs/gate" },
        "status": { "$ref": "#/$defs/evidenceStatus" },
        "command": { "type": ["string", "null"] },
        "result": { "type": ["string", "null"] },
        "exitCode": { "type": ["integer", "null"] },
        "artifactPath": { "type": ["string", "null"] },
        "artifactHash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "inputTreeHash": { "$ref": "#/$defs/sha256" },
        "criteriaHash": { "$ref": "#/$defs/sha256" },
        "relevantFiles": { "type": "array", "items": { "type": "string" } },
        "toolVersion": { "type": ["string", "null"] },
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{4,40}$",
          "description": "Optional. The revision this evidence attests, as an abbreviated or full SHA. Supplied via --commit on `harness verify`/`harness confirm`. A branch or tag name is rejected because it moves, so the citation could not be checked later. Null when the recorder supplied none, which keeps v2-shaped records valid."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "freshnessPolicy": { "oneOf": [{ "$ref": "#/$defs/freshnessPolicy" }, { "type": "null" }] },
        "supersededBy": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "source": { "type": "string", "enum": ["automated", "manual-confirmation", "provider"] },
        "checks": {
          "type": ["array", "null"],
          "description": "Architecture fitness only. One entry per check that ran: id, severity, status (passed/failed/blocked), exit code, and the artifact the check declared with its hash. Required on an architectureFitnessPassed record, because a record that attests 'the constraints hold' must name which checks proved it.",
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string" },
              "severity": { "type": "string", "enum": ["required", "advisory"] },
              "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
              "exitCode": { "type": ["integer", "null"] },
              "artifactPath": { "type": ["string", "null"] },
              "artifactHash": { "type": ["string", "null"] },
              "refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "witness": { "type": ["string", "null"], "description": "Human acceptance only. What a person did and what they saw — the user-observable witness the acceptance rests on. Required (non-empty) on a humanAcceptanceConfirmed record; state validation refuses a record without it." },
        "limitations": { "type": ["string", "null"], "description": "Human acceptance only. What the person accepted as missing, or the literal \"none\". Required (non-empty) on a humanAcceptanceConfirmed record, so a limitation nobody wrote down cannot be discovered later by surprise." },
        "gateContract": { "type": ["string", "null"], "pattern": "^[A-Za-z]+@[0-9]+$", "description": "The gate's evidence contract when the record was written, e.g. \"testsPassed@1\" (registry: src/harness/gates.mjs). Automated records carry it; a manual confirmation carries null, because no builder produced it. evidenceFreshness refuses a record whose contract differs from the gate's current one, so a change to a builder's rules cannot silently re-read old evidence as if nothing had changed. A record that declares null predates the field and stays valid, which keeps v2-shaped records valid." },
        "sealedCommit": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }],
          "description": "v5 read-time only. The commit whose trailers carried this record, stamped by `sealedEvidence`. Never written by hand: the commit id is the seal, so a record cannot name the commit it is stored in without being self-referential."
        },
        "partial": {
          "type": "boolean",
          "description": "v5 read-time only. The trailer block was truncated to fit the output bound, so `relevantFiles` is incomplete. A partial record must NOT satisfy a gate: it no longer binds the evidence to the files it claims."
        },
        "reason": {
          "type": "string",
          "description": "v3: why automation was unavailable. Required on a manual-confirmation under strictClosure (contract v3 §3)."
        },
        "environment": {
          "type": "object",
          "description": "v3: what was actually verified and against which toolchain. Required on a manual-confirmation under strictClosure. At least one of projectPath/tool must be present.",
          "properties": {
            "projectPath": { "type": ["string", "null"] },
            "editorVersion": { "type": ["string", "null"] },
            "tool": { "type": ["string", "null"] },
            "host": { "type": ["string", "null"] },
            "os": { "type": ["string", "null"] }
          },
          "additionalProperties": true
        },
        "scope": {
          "type": "array",
          "items": { "type": "string" },
          "description": "v3: what the confirmation covers. Required non-empty on a manual-confirmation under strictClosure. Distinct from the free-text result, which is never machine-read."
        }
      },
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "required": ["spanId", "runId", "kind", "startedAt", "status"],
      "properties": {
        "spanId": { "$ref": "#/$defs/uuid" },
        "runId": { "$ref": "#/$defs/uuid" },
        "parentSpanId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "kind": {
          "type": "string",
          "enum": ["context-load", "tool-call", "tool-output", "verification", "retry", "phase-transition", "budget-warning", "decision", "error"]
        },
        "name": { "type": "string" },
        "tier": { "oneOf": [{ "$ref": "#/$defs/contextTier" }, { "type": "null" }] },
        "reason": { "type": ["string", "null"] },
        "tool": { "type": ["string", "null"] },
        "args": { "type": ["object", "null"] },
        "result": { "type": ["string", "null"] },
        "exitCode": { "type": ["integer", "null"] },
        "retryClass": { "oneOf": [{ "$ref": "#/$defs/retryClass" }, { "type": "null" }] },
        "retryNumber": { "type": ["integer", "null"], "minimum": 0 },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": ["string", "null"], "format": "date-time" },
        "durationMs": { "type": ["number", "null"], "minimum": 0 },
        "outputBytes": { "type": ["integer", "null"], "minimum": 0 },
        "artifactPath": { "type": ["string", "null"] },
        "artifactHash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "status": { "type": "string", "enum": ["ok", "warning", "failed", "blocked", "exhausted", "timed-out"] },
        "error": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["decisionId", "runId", "kind", "reason", "createdAt"],
      "properties": {
        "decisionId": { "$ref": "#/$defs/uuid" },
        "runId": { "$ref": "#/$defs/uuid" },
        "kind": { "type": "string", "enum": ["transition", "escalation", "budget-override", "gate-exception", "stop"] },
        "from": { "type": ["string", "null"] },
        "to": { "type": ["string", "null"] },
        "reason": { "type": "string" },
        "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/uuid" } },
        "approvedBy": { "type": ["string", "null"] },
        "expiresAt": { "type": ["string", "null"], "format": "date-time" },
        "scope": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "enum": ["provider", "estimate", "unknown"] },
        "inputTokens": { "type": ["integer", "null"] },
        "outputTokens": { "type": ["integer", "null"] },
        "cachedTokens": { "type": ["integer", "null"] },
        "confidence": { "type": ["string", "null"] },
        "usd": { "type": ["number", "null"] },
        "model": { "type": ["string", "null"] },
        "rateCardId": { "type": ["string", "null"] },
        "effectiveDate": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "required": ["runId", "startedAt", "status", "spans", "budget"],
      "properties": {
        "runId": { "$ref": "#/$defs/uuid" },
        "schemaVersion": { "type": "integer", "const": 2 },
        "workItemId": { "type": ["string", "null"] },
        "phase": { "oneOf": [{ "$ref": "#/$defs/phase" }, { "type": "null" }] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": ["string", "null"], "format": "date-time" },
        "status": { "type": "string", "enum": ["running", "ok", "warning", "failed", "blocked", "exhausted"] },
        "spans": { "type": "array", "items": { "$ref": "#/$defs/span" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
        "budget": {
          "type": "object",
          "required": ["status", "ok", "checks"],
          "properties": {
            "status": { "type": "string", "enum": ["ok", "warning", "exhausted"] },
            "ok": { "type": "boolean" },
            "exhausted": { "type": "boolean" },
            "checks": { "type": "array" },
            "counters": { "type": "object" }
          }
        },
        "usage": { "oneOf": [{ "$ref": "#/$defs/usage" }, { "type": "null" }] },
        "capabilities": { "type": "object" },
        "retention": {
          "type": "object",
          "properties": {
            "rawPromptRetained": { "type": "boolean" },
            "keepOnFailure": { "type": "boolean" }
          }
        }
      },
      "additionalProperties": false
    },
    "stateV2": {
      "type": "object",
      "required": ["version", "session", "epics"],
      "properties": {
        "version": { "type": "integer", "const": 2 },
        "stateVersion": { "type": "integer", "const": 2 },
        "session": {
          "type": "object",
          "required": ["workflowPath", "currentPhase", "trackingMode"],
          "properties": {
            "trackingMode": { "type": "string", "enum": ["markdown", "github"] },
            "learnerTier": { "type": "string", "enum": ["beginner", "intermediate", "advanced", "guided"] },
            "operatingMode": { "type": "string", "enum": ["instruction-first", "implementation-first", "hybrid"] },
            "workflowPath": { "type": "string", "enum": ["large", "small", "no_test_required"] },
            "currentPhase": { "$ref": "#/$defs/phase" }
          }
        },
        "activeRunId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "activeWorkItem": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "epicId": { "type": ["string", "null"] },
                "storyId": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "epics": { "type": "object" },
        "gates": { "type": "object" },
        "gateEvidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "lastTransition": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "from": { "$ref": "#/$defs/phase" },
                "to": { "$ref": "#/$defs/phase" },
                "at": { "type": "string", "format": "date-time" },
                "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/uuid" } }
              },
              "required": ["from", "to", "at"]
            },
            { "type": "null" }
          ]
        },
        "spikes": { "type": "object" },
        "changeHistory": { "type": "array" }
      }
    },
    "stateV4": {
      "type": "object",
      "description": "v4 state: evidence history left the document (contract v5). `gateEvidence` is scoped to the active work item, `evidenceCoverage` indexes what moved to commits and `.cadet/archive/`, gate exceptions have their own field, and `changeHistory` is retired. Full shape: .cadet/agent/core/state.schema.json.",
      "required": ["version", "session", "epics"],
      "properties": {
        "version": { "type": "integer", "const": 4 },
        "stateVersion": { "type": "integer", "const": 4 },
        "session": { "type": "object" },
        "epics": { "type": "object" },
        "gates": { "type": "object" },
        "gateEvidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "evidenceCoverage": {
          "type": "object",
          "description": "Per-work-item summary of evidence that is no longer inline. Keeps the 'a done story owns evidence' check answerable without git.",
          "additionalProperties": {
            "type": "object",
            "required": ["recordCount"],
            "properties": {
              "workItemId": { "type": "string" },
              "recordCount": { "type": "integer", "minimum": 0 },
              "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
              "firstAt": { "type": ["string", "null"], "format": "date-time" },
              "lastAt": { "type": ["string", "null"], "format": "date-time" },
              "sealedCommit": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
            }
          }
        },
        "gateExceptions": {
          "type": "array",
          "description": "Gate exceptions, which are live state (scoped + expiring) rather than history.",
          "items": { "type": "object" }
        },
        "activeRunId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "activeWorkItem": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "epicId": { "type": ["string", "null"] },
                "storyId": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        },
        "lastTransition": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "from": { "$ref": "#/$defs/phase" },
                "to": { "$ref": "#/$defs/phase" },
                "at": { "type": "string", "format": "date-time" },
                "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/uuid" } }
              },
              "required": ["from", "to", "at"]
            },
            { "type": "null" }
          ]
        },
        "spikes": { "type": "object" }
      }
    }
  }
}
