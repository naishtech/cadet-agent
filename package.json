{
  "name": "cadet-agent",
  "version": "0.63.1",
  "description": "Cross-IDE agent framework for Unity/C# game-development — one-command install",
  "type": "module",
  "bin": {
    "cadet-agent": "bin/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:cli": "bash packages/cli/test/run.sh",
    "lint": "lychee --offline --include-fragments \"**/*.md\"",
    "verify": "npm test && npm run test:cli && npm run lint"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "keywords": [
    "cadet",
    "cadet-agent",
    "unity",
    "game-development",
    "ai-agent",
    "copilot",
    "cursor",
    "claude-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naishtech/cadet-agent.git"
  },
  "homepage": "https://github.com/naishtech/cadet-agent#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "nomnoml": "^1.7.0"
  }
}
